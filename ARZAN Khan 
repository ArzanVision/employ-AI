  <div class="header"><h1>EMPLOY-AI</h1></div>
  
  <div class="row">
    <div class="box">WORKERS</div>
    <div class="box">CUSTOMERS</div>
    <div class="box">EMPLOYERS</div>
  </div>

  <div class="engine">AI INTELLIGENCE</div>

  <div class="row">
    <div class="box">SKILL ANALYSIS</div>
    <div class="box">OPPORTUNITY MATCHING</div>
    <div class="box">MARKET RESEARCH</div>
  </div>

  <div class="engine">OPPORTUNITY ENGINE</div>

  <div class="row">
    <div class="box">JOBS</div>
    <div class="box">PROJECTS</div>
    <div class="box">BUSINESS CREATION</div>
  </div>
</body>
</html>